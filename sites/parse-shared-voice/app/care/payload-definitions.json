{
  "health_note": {
    "additionalProperties": false,
    "properties": {
      "wording": {
        "maxLength": 4000,
        "minLength": 1,
        "title": "Wording",
        "type": "string"
      },
      "symptom": {
        "anyOf": [
          {
            "maxLength": 200,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Symptom"
      },
      "occurrence_text": {
        "anyOf": [
          {
            "maxLength": 1000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Preserve the speaker's approximate time, such as this morning. Use null when occurred_at is supplied or no time was stated.",
        "title": "Occurrence Text"
      },
      "occurred_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Only an exact date and clock time stated by the speaker. Use null for approximate time; never infer midnight from today or this morning.",
        "title": "Occurred At"
      },
      "timezone": {
        "anyOf": [
          {
            "maxLength": 80,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Timezone"
      },
      "share_with_user_ids": {
        "items": {
          "type": "string"
        },
        "title": "Share With User Ids",
        "type": "array"
      },
      "share_with_names": {
        "items": {
          "type": "string"
        },
        "title": "Share With Names",
        "type": "array"
      }
    },
    "required": [
      "wording"
    ],
    "title": "HealthNotePayload",
    "type": "object"
  },
