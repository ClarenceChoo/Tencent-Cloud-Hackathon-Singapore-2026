  {
    "type": "function",
    "name": "request_support",
    "description": "Use for one care action only. If speech contains multiple independent events or requests, ask which one to handle first; do not merge or drop actions. Propose one support request for one explicitly identified permitted recipient. This only prepares a request for dashboard review; it does not send or dispatch help. Clarify the recipient when ambiguous. For urgent danger, use the supplied calling_route guidance. Explicit dashboard confirmation is required before sharing.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "propose",
            "correct"
          ],
          "description": "Use correct only when revising the identified current proposal."
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "request_text": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "recipient_user_id": {
              "type": "string"
            },
            "urgency": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "routine",
                    "urgent"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "barrier_text": {
              "anyOf": [
                {
                  "maxLength": 2000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "request_text",
            "recipient_user_id",
            "urgency",
            "barrier_text"
          ],
          "type": "object"
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "update_followup",
    "description": "Use for one care action only. If speech contains multiple independent events or requests, ask which one to handle first; do not merge or drop actions. Propose one follow-up tied to a supplied record, with the stated check time and sharing choice, or resolve a supplied follow-up using a human-reported outcome. Do not infer an outcome from silence. Ask permission before sharing; medication-report follow-ups must remain private. Dashboard review and explicit confirmation are required before saving.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "propose",
            "correct"
          ],
          "description": "Use correct only when revising the identified current proposal."
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "followup_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "related_type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "support_request",
                    "health_note",
                    "medication_report"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "related_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "check_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "permission_scope": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string",
                  "enum": [
                    "private",
                    "related_recipients"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reported_outcome": {
              "anyOf": [
                {
                  "maxLength": 2000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution_state": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open",
                    "resolved"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object",
          "required": [
            "followup_id",
            "related_type",
            "related_id",
            "check_at",
            "permission_scope",
            "reported_outcome",
            "resolution_state"
          ]
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "confirm_current_update",
    "description": "Use for one request only. If speech contains multiple independent actions or questions, ask which one to handle first. Use only when the current utterance clearly and explicitly confirms the single identified current proposal. The server rechecks the words and permissions. This function does not save the care update; the person must still review and confirm it on the dashboard.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "get_medication_explanation",
    "description": "Use for one request only. If speech contains multiple independent actions or questions, ask which one to handle first. Read the reviewed instructions and source for one uniquely identified medicine in the active checked plan. Use only for a question about those stored instructions. Do not add medical advice, recommend dose changes, or infer that the medicine caused a symptom.",
    "parameters": {
      "type": "object",
      "properties": {
        "medicine_id": {
          "type": "string"
        }
      },
      "required": [
        "medicine_id"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "get_support_status",
    "description": "Use for one request only. If speech contains multiple independent actions or questions, ask which one to handle first. Read stored status for one uniquely identified support request. Report acknowledgement or resolution only when the stored record explicitly contains it; never infer that someone has seen or acted on the request.",
    "parameters": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string"
        }
      },
      "required": [
        "record_id"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "get_followup_status",
    "description": "Use for one request only. If speech contains multiple independent actions or questions, ask which one to handle first. Read stored status for one uniquely identified follow-up. Report an outcome only when the record contains a human-reported outcome; silence does not mean resolved.",
    "parameters": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string"
        }
      },
      "required": [
        "record_id"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "respond_to_user",
    "description": "Use to ask which action to handle first when speech contains multiple independent events or requests; never handle only one silently. Also use for one focused clarification or ordinary conversation. Ask one focused clarification question when a required fact, reference, or intended action is ambiguous or missing. Use chat for ordinary conversation or to explain a capability limit, such as medication reminders not being supported here. Never claim a record was saved, a request sent, or a person acknowledged it.",
    "parameters": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "clarify",
            "chat"
          ]
        },
        "spoken_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "intent",
        "spoken_text"
      ],
      "additionalProperties": false
    },
    "strict": true
  }
]
