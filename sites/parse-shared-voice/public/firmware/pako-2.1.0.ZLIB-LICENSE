See state defs from inflate.js






(!) This block is disabled in zlib defaults,
don't enable it for binary compatibility

               if (len <= op - whave) {
                 do {
                   output[_out++] = 0;
                 } while (--len);
                 continue top;
               }
               len -= op - whave;
               do {
                 output[_out++] = 0;
               } while (--op > whave);
               if (op === 0) {
                 from = _out - dist;
                 do {
                   output[_out++] = output[from++];
                 } while (--len);
                 continue top;
               }

