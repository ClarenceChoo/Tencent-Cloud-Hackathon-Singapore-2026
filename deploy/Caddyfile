{$CARELOOP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    @companionDocument path /companion /companion/*
    header @companionDocument Permissions-Policy "camera=(), microphone=(self), geolocation=()"
    @otherDocument not path /companion /companion/*
    header @otherDocument Permissions-Policy "camera=(), microphone=(), geolocation=()"
    @uploadAudio path /v1/phone/turns /v1/web/turns
    request_body @uploadAudio {
        max_size 2097152
    }
    @otherBody not path /v1/phone/turns /v1/web/turns
    request_body @otherBody {
        max_size 1MB
    }
    handle /v1/* {
        reverse_proxy backend:8000
    }
    handle /healthz {
        reverse_proxy backend:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
