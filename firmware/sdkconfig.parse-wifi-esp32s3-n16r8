# Wiring for the confirmed ESP32-S3 N16R8 / INMP441 setup.
# Keep speaker and amplifier GPIOs disabled: this build records microphone audio only.
CONFIG_CARELOOP_DIRECT_WIFI=y
CONFIG_CARELOOP_MIC_BCLK_GPIO=4
CONFIG_CARELOOP_MIC_WS_GPIO=5
CONFIG_CARELOOP_MIC_DATA_GPIO=6
CONFIG_CARELOOP_MIC_LEFT_CHANNEL=y
CONFIG_CARELOOP_SPK_BCLK_GPIO=-1
CONFIG_CARELOOP_SPK_WS_GPIO=-1
CONFIG_CARELOOP_SPK_DATA_GPIO=-1
CONFIG_CARELOOP_AMP_ENABLE_GPIO=17
CONFIG_CARELOOP_AMP_ENABLE_ACTIVE_HIGH=y
CONFIG_CARELOOP_PTT_GPIO=-1
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32s3-n16r8.csv"
