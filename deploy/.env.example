# Copy to deploy/.env; never commit the filled-in file.
CARELOOP_DOMAIN=careloop.example
# Use a random URL-safe password, e.g. 32 random bytes represented as hex.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
CARELOOP_PROVIDER=unconfigured
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=
CARELOOP_ASR_HOST=asr.tencentcloudapi.com
CARELOOP_ASR_ENGINE=16k_en
CARELOOP_TTS_HOST=tts.intl.tencentcloudapi.com
CARELOOP_TTS_VOICE_TYPE=
CARELOOP_TTS_PRIMARY_LANGUAGE=2
CARELOOP_LLM_BASE_URL=
CARELOOP_LLM_MODEL=
CARELOOP_LLM_API_KEY=
