# Safe local defaults. Development seed data is fictional and still requires explicit opt-in.
CARELOOP_DATABASE_URL=sqlite:///./careloop.db
CARELOOP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CARELOOP_COOKIE_SECURE=false
CARELOOP_SESSION_TTL_HOURS=12
CARELOOP_DEVELOPMENT_SEED=false
CARELOOP_ADMIN_ENABLED=false
CARELOOP_PROVIDER=unconfigured
# Set to the same public HTTPS origin used by the pendant. No path or trailing slash.
CARELOOP_PUBLIC_BASE_URL=
CARELOOP_AUDIO_RETENTION_HOURS=24
CARELOOP_SCHEDULER_INTERVAL_SECONDS=5
CARELOOP_SCHEDULER_ENABLED=true

# Set only in the deployment secret store when CARELOOP_PROVIDER=tencent.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=
CARELOOP_ASR_HOST=asr.tencentcloudapi.com
CARELOOP_ASR_ENGINE=16k_en
CARELOOP_TTS_HOST=tts.intl.tencentcloudapi.com
CARELOOP_TTS_VOICE_TYPE=
CARELOOP_TTS_PRIMARY_LANGUAGE=2
CARELOOP_LLM_BASE_URL=
CARELOOP_LLM_MODEL=
CARELOOP_LLM_API_KEY=

# Backend-only fixture mode. Requires CARELOOP_PROVIDER=fixture and CARELOOP_TESTING=true.
CARELOOP_TESTING=false
CARELOOP_FIXTURE_REPLY_WAV=

# OpenAI-only voice: set CARELOOP_PROVIDER=openai and supply the key on the server.
OPENAI_API_KEY=
CARELOOP_OPENAI_MODEL=gpt-4.1-mini
CARELOOP_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
CARELOOP_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
CARELOOP_OPENAI_VOICE=coral
