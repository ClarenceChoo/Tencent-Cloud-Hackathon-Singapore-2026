        <mxCell id="confirm-commit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#147D75;strokeWidth=2;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="confirm" target="commit">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-title" value="&lt;b&gt;Parse | From voice to a confirmed care record&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;spacing=0;spacingTop=0;fontSize=20;fontSize=36;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="40" width="1480" height="50" />
        </mxCell>
        <mxCell id="flow-subtitle" value="&lt;b&gt;Backend logic owns validation, read-back and persistence; clients provide explicit review and confirmation&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;spacing=0;spacingTop=0;fontSize=20;fontSize=36;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="104" width="1480" height="36" />
        </mxCell>
        <mxCell id="capture" value="&lt;b&gt;1  Deliberate recording&lt;/b&gt;&lt;br&gt;Browser / native / cardholder&lt;br&gt;Short recording + retry identity&lt;br&gt;User sends captured audio" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FE;strokeColor=#A6C6F3;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="235" width="310" height="160" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;2  Accept + normalize&lt;/b&gt;&lt;br&gt;Authenticate installation&lt;br&gt;Persist idempotent turn receipt&lt;br&gt;Canonical 16 kHz PCM WAV" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FE;strokeColor=#A6C6F3;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="235" width="310" height="160" />
        </mxCell>
        <mxCell id="transcribe" value="&lt;b&gt;3  Speech recognition&lt;/b&gt;&lt;br&gt;Tencent Cloud ASR&lt;br&gt;WAV → transcript&lt;br&gt;Delete raw input after ASR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#C6B5E3;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="235" width="310" height="160" />
        </mxCell>
        <mxCell id="interpret" value="&lt;b&gt;4  Interpret intent&lt;/b&gt;&lt;br&gt;Configured LLM endpoint&lt;br&gt;Transcript + scoped care context&lt;br&gt;Structured JSON proposal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#C6B5E3;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="235" width="310" height="160" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;5  Validate + propose&lt;/b&gt;&lt;br&gt;Backend schema / domain checks&lt;br&gt;Snapshot + expiry + context ID&lt;br&gt;Deterministic read-back text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F5F2;strokeColor=#9BCDC6;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="520" width="310" height="160" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;6  Read-back + review&lt;/b&gt;&lt;br&gt;Tencent TTS → bounded WAVs&lt;br&gt;Client shows / plays proposal&lt;br&gt;Correct or cancel before saving" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FE;strokeColor=#A6C6F3;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="520" width="310" height="160" />
        </mxCell>
        <mxCell id="confirm" value="&lt;b&gt;7  Explicit confirmation&lt;/b&gt;&lt;br&gt;Confirm UI or deliberate reply&lt;br&gt;Recheck access + proposal state&lt;br&gt;Bind to current review context" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F5F2;strokeColor=#9BCDC6;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="520" width="310" height="160" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;8  Atomic care-record write&lt;/b&gt;&lt;br&gt;Commit proposal exactly once&lt;br&gt;Store provenance in PostgreSQL&lt;br&gt;Permitted caregiver reads update" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F5F2;strokeColor=#9BCDC6;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="520" width="310" height="160" />
        </mxCell>
        <mxCell id="proposal-only" value="&lt;b&gt;Recording receipt and proposal creation do not save a confirmed care fact.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;spacing=0;spacingTop=0;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="1440" height="35" />
        </mxCell>
        <mxCell id="correction" value="&lt;b&gt;Correct / cancel&lt;/b&gt;&lt;br&gt;Correction invalidates the old proposal and creates a fresh read-back.&lt;br&gt;Cancellation leaves the proposed care fact unsaved." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3D0DD;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="755" width="680" height="108" />
        </mxCell>
        <mxCell id="delivery" value="&lt;b&gt;Durable delivery + recovery&lt;/b&gt;&lt;br&gt;Authenticated audio / events; WSS where used, HTTPS polling for recovery.&lt;br&gt;Reminders track playback separately from reported medication status." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3D0DD;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="755" width="680" height="108" />
        </mxCell>
        <mxCell id="flow-footer" value="&lt;b&gt;30 Sep 2026 · Repository implementation flow. Provider access, physical operation and production deployment need separate validation.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontColor=#172D44;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=20;spacingTop=16;spacing=0;spacingTop=0;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="903" width="1480" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
