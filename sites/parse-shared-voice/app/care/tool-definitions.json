[
  {
    "type": "function",
    "name": "propose_health_note",
    "description": "Use for one care action only. If speech contains multiple independent events or requests, ask which one to handle first; do not merge or drop actions. Propose one general health observation or symptom the speaker reports. Keep it private unless they explicitly ask to share it with one identified permitted recipient. Route blood-pressure values to record_measurement and dose-status reports to report_medication. Does not create medication reminders. Dashboard review and explicit confirmation are required before saving.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "propose",
            "correct"
          ],
          "description": "Use correct only when revising the identified current proposal."
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "wording": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "symptom": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurrence_text": {
              "anyOf": [
                {
                  "maxLength": 1000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preserve the speaker's approximate time, such as this morning. Use null when occurred_at is supplied or no time was stated."
            },
            "occurred_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only an exact date and clock time stated by the speaker. Use null for approximate time; never infer midnight from today or this morning."
            },
            "timezone": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "share_with_user_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "wording",
            "symptom",
            "occurrence_text",
            "occurred_at",
            "timezone",
            "share_with_user_ids"
          ],
          "type": "object"
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "report_medication",
    "description": "Use for one care action only. If speech contains multiple independent events or requests, ask which one to handle first; do not merge or drop actions. Propose only the speaker-reported status of one uniquely identified dose in the active checked plan. This records a report; it does not set a reminder, change a plan or dose, or confirm medication was taken unless the speaker says so. Ask which dose when multiple entries match. Dashboard review and explicit confirmation are required before saving.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "propose",
            "correct"
          ],
          "description": "Use correct only when revising the identified current proposal."
        },
        "payload": {
          "type": "object",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dose_instance_id": {
                  "type": "string"
                },
                "report_state": {
                  "type": "string",
                  "enum": [
                    "reported_taken"
                  ]
                },
                "taken_time_text": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Only when the speaker explicitly says when this dose was taken; otherwise null."
                }
              },
              "required": [
                "dose_instance_id",
                "report_state",
                "taken_time_text"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dose_instance_id": {
                  "type": "string"
                },
                "report_state": {
                  "type": "string",
                  "enum": [
                    "reported_skipped",
                    "reported_not_yet",
                    "reported_uncertain"
                  ]
                },
                "taken_time_text": {
                  "type": "null",
                  "description": "Must be null unless report_state is reported_taken and the speaker explicitly stated when it was taken."
                }
              },
              "required": [
                "dose_instance_id",
                "report_state",
                "taken_time_text"
              ]
            }
          ]
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "record_measurement",
    "description": "Use for one care action only. If speech contains multiple independent events or requests, ask which one to handle first; do not merge or drop actions. Propose one externally reported blood-pressure reading. Require the spoken systolic and diastolic values and the measurement source; clarify missing facts instead of storing a general note. Preserve approximate time as spoken and never infer a value or exact time. This is not a microphone/device measurement. Dashboard review and explicit confirmation are required before saving.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "propose",
            "correct"
          ],
          "description": "Use correct only when revising the identified current proposal."
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "measurement_type": {
              "type": "string",
              "enum": [
                "blood_pressure"
              ]
            },
            "systolic": {
              "maximum": 300,
              "minimum": 40,
              "type": "integer"
            },
            "diastolic": {
              "maximum": 200,
              "minimum": 20,
              "type": "integer"
            },
            "unit": {
              "type": "string",
              "enum": [
                "mmHg"
              ]
            },
            "occurred_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurrence_text": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Copy an exact short excerpt of the speaker’s approximate time, such as this morning. Do not paraphrase or supply a default. Ask for the time if neither an approximate time nor an exact date and clock time were stated."
            },
            "timezone": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "source_description": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string",
              "description": "Copy the speaker’s stated source/device/location as an exact short excerpt from this transcript or the directly preceding clarification conversation. Never use a placeholder such as unknown or not specified. If no source is stated, ask for it with respond_to_user."
            },
            "reporting_actor": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string",
              "enum": [
                "patient",
                "caregiver"
              ]
            },
            "supersedes_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "measurement_type",
            "systolic",
            "diastolic",
            "unit",
            "occurred_at",
            "occurrence_text",
            "timezone",
            "source_description",
            "reporting_actor",
            "supersedes_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    "strict": true
  },
